{
  "name": "teammapper-frontend",
  "version": "0.1.9",
  "description": "Web application to draw mind maps, based on mindmapp.",
  "homepage": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/b310/teammapper.git"
  },
  "author": {
    "name": "b310 digital gmbh",
    "email": "kontakt@b310.de",
    "url": "https://b310.de"
  },
  "license": "MIT",
  "engines": {
    "node": "^24.0"
  },
  "keywords": [
    "mindmap",
    "node",
    "branch",
    "map",
    "mind",
    "infovis"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host ${BINDING:-0.0.0.0} --ssl false",
    "test": "ng test",
    "tsc": "npx tsc -p ./tsconfig.json --noEmit",
    "build:packages": "pnpm install --filter \"@teammapper/*\" --frozen-lockfile && pnpm run --filter \"@teammapper/*\" build",
    "build:dev": "pnpm run build:packages && ng build",
    "build:prod": "pnpm run build:packages && ng build --configuration production",
    "lint": "ng lint",
    "doc": "compodoc -p src/tsconfig.app.json",
    "format": "npx prettier . --write",
    "format:check": "npx prettier . --check",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "@angular-devkit/build-angular": "21.2.22",
    "@angular/animations": "21.2.22",
    "@angular/cdk": "21.2.14",
    "@angular/cli": "21.2.22",
    "@angular/common": "21.2.22",
    "@angular/compiler": "21.2.22",
    "@angular/compiler-cli": "21.2.22",
    "@angular/core": "21.2.22",
    "@angular/forms": "21.2.22",
    "@angular/material": "21.2.14",
    "@angular/platform-browser": "21.2.22",
    "@angular/platform-browser-dynamic": "21.2.22",
    "@angular/router": "21.2.22",
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@material-design-icons/font": "^0.14.15",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "@teammapper/mermaid-mindmap-parser": "workspace:^",
    "@teammapper/mmp": "workspace:*",
    "@teammapper/shared": "workspace:*",
    "angular2-hotkeys": "^16.0.1",
    "dompurify": "3.4.9",
    "jspdf": "^4.2.1",
    "localforage": "1.10.0",
    "ngx-color-picker": "^20.1.1",
    "ngx-toastr": "^20.0.5",
    "qr-code-styling": "1.9.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "uuid": "13.0.1",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.3",
    "@angular-eslint/builder": "21.3.1",
    "@angular-eslint/schematics": "21.3.1",
    "@angular/language-service": "21.2.6",
    "@compodoc/compodoc": "^1.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jest": "30.0.0",
    "@types/mousetrap": "1.6.15",
    "@types/node": "^24.13.3",
    "angular-eslint": "^21.3.1",
    "eslint": "^10.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^16.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
