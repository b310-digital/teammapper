{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/*.css",
          "/*.js",
          "/media/**",
          "/assets/icons/**",
          "/assets/images/**",
          "/assets/i18n/*.json",
          "/assets/settings.offline.json"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/**/*.(svg|png|jpg|jpeg|gif|webp|otf|ttf|eot|woff|woff2)"]
      }
    }
  ]
}
