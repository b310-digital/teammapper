{
  "name": "@teammapper/mmp",
  "version": "0.0.1",
  "private": false,
  "description": "Browser mind map rendering library for TeamMapper, based on cedoor/mmp",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "clean": "rm -rf dist",
    "tsc": "tsc -p tsconfig.json",
    "test": "jest",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@teammapper/shared": "workspace:*",
    "d3": "7.9.0",
    "deep-object-diff": "^1.1.9",
    "dompurify": "3.4.9",
    "uuid": "13.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/d3": "7.4.3",
    "@types/jest": "30.0.0",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "29.4.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
